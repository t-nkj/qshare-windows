# Required: device token issued by QShare.
QSHARE_TOKEN=qsh_replace_me

# Optional. The client appends v1/ to this base URL.
API_BASE_URL=https://qshare.trap.show/api/

# Optional. Defaults to the files folder next to QShare.exe.
# QSHARE_DOWNLOAD_DIR=C:\\path\\to\\custom-folder

# Optional. Set true to write qshare.log next to QShare.exe.
# QSHARE_LOG=true
# Optional. error, info (default), or debug.
# QSHARE_LOG_LEVEL=info
